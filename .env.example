# ============================================================
# XAUUSD AI TELEGRAM BOT — salin jadi ".env" lalu isi.
# Otak AI: Groq saja (gratis selamanya, tanpa kartu kredit).
# ============================================================

# --- Telegram (wajib) ---
# Dapatkan token dari @BotFather di Telegram.
TELEGRAM_BOT_TOKEN=
# User ID yang diizinkan (pisah koma). Kosongkan = bot publik.
# Cari ID Anda via @userinfobot.
ALLOWED_USER_IDS=
# Instrumen default untuk analisa & broadcast.
DEFAULT_SYMBOL=XAU/USD
# Interval broadcast otomatis (menit). Minimal 5.
BROADCAST_INTERVAL_MIN=30

# --- Groq (otak AI utama & satu-satunya, GRATIS) ---
# Daftar & buat key: https://console.groq.com/keys
# Model gratis: llama-3.3-70b-versatile (paling pintar), llama-3.1-8b-instant (lebih cepat).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- TwelveData (market data, wajib) ---
# https://twelvedata.com/ (paket gratis)
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# --- SoSoValue (market data crypto tambahan, opsional) ---
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1
SOSOVALUE_KLINE_PATH=/currency/historical-klines
