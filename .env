# File .env LOKAL — berisi kredensial asli. JANGAN di-commit.
# Otak AI: Groq saja (gratis). Isi TELEGRAM_BOT_TOKEN, GROQ_API_KEY, TWELVEDATA_API_KEY.

TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
DEFAULT_SYMBOL=XAU/USD
BROADCAST_INTERVAL_MIN=30

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com

SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1
SOSOVALUE_KLINE_PATH=/currency/historical-klines
